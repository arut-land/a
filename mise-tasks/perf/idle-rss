#!/usr/bin/env python3
#MISE description="Sample idle daemon RSS and CPU using native process counters"
"""Fresh fixture homes; measure an idle line REPL and its daemon on every OS."""
import argparse
import json
import os
from pathlib import Path
import queue
import subprocess
import sys
import tempfile
import threading
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts/perf"))
from process import snapshot


def sample(binary, idle_seconds):
    with tempfile.TemporaryDirectory(prefix="a-rss-", dir=os.environ.get("RUNNER_TEMP")) as directory:
        home = Path(directory)
        (home / "config.toml").write_text('[daemon]\nagent = "echo"\nidle_secs = 120\n')
        env = dict(os.environ, A_HOME=str(home), A_TUI="plain")
        env.pop("A_HOST", None)
        client = subprocess.Popen([binary], env=env, cwd=home, stdin=subprocess.PIPE,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        try:
            first = queue.Queue()
            threading.Thread(target=lambda: first.put(client.stdout.readline()), daemon=True).start()
            assert first.get(timeout=30).startswith(b"[session")
            pid = int((home / "run/daemon.pid").read_text().splitlines()[0])
            time.sleep(3)
            before = [snapshot(p)["cpu_seconds"] for p in (pid, client.pid)]
            started = time.monotonic()
            time.sleep(idle_seconds)
            elapsed = time.monotonic() - started
            after = [snapshot(p) for p in (pid, client.pid)]
            return dict(rss=after[0]["rss_kib"], seconds=elapsed,
                        daemon_cpu_seconds=after[0]["cpu_seconds"] - before[0],
                        client_cpu_seconds=after[1]["cpu_seconds"] - before[1])
        finally:
            client.stdin.close()
            try:
                client.wait(timeout=15)
            except subprocess.TimeoutExpired:
                client.kill()
                client.wait()
            subprocess.run([binary, "daemon", "stop"], env=env, check=True,
                           capture_output=True, timeout=30)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("binary", type=Path)
    parser.add_argument("label")
    parser.add_argument("--samples", type=int, default=5)
    parser.add_argument("--idle-seconds", type=float, default=10)
    parser.add_argument("--output", type=Path, default=Path("target/rss"))
    args = parser.parse_args()
    if args.samples < 1 or args.idle_seconds < 0:
        parser.error("samples must be positive and idle-seconds nonnegative")
    args.output.mkdir(parents=True, exist_ok=True)
    samples = [sample(str(args.binary.resolve(strict=True)), args.idle_seconds) for _ in range(args.samples)]
    record = dict(commit=args.label, rss=[value["rss"] for value in samples],
                  bytes=args.binary.stat().st_size, samples=samples)
    print(json.dumps(record))
    with (args.output / "samples.jsonl").open("a") as stream:
        stream.write(json.dumps(record) + "\n")


if __name__ == "__main__":
    main()

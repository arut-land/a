#!/usr/bin/env python3
#MISE description="Sample idle daemon RSS and CPU using native process counters"
"""Fresh fixture homes; measure an idle line REPL and its daemon on every OS."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts/perf"))
from lifecycle import daemon, idle_sample


def sample(binary, idle_seconds, output=None, trial=0):
    with daemon(binary, output, trial, ready_timeout=30) as active:
        return idle_sample(active, idle_seconds)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("binary", type=Path)
    parser.add_argument("label")
    parser.add_argument("--samples", type=int, default=5)
    parser.add_argument("--idle-seconds", type=float, default=10)
    parser.add_argument("--output", type=Path, default=Path("target/rss"))
    args = parser.parse_args()
    if args.samples < 1 or args.idle_seconds < 0:
        parser.error("samples must be positive and idle-seconds nonnegative")
    args.output.mkdir(parents=True, exist_ok=True)
    samples = [sample(str(args.binary.resolve(strict=True)), args.idle_seconds, args.output, trial)
               for trial in range(args.samples)]
    record = dict(commit=args.label, rss=[value["rss"] for value in samples],
                  bytes=args.binary.stat().st_size, samples=samples)
    print(json.dumps(record))
    with (args.output / "samples.jsonl").open("a") as stream:
        stream.write(json.dumps(record) + "\n")


if __name__ == "__main__":
    main()

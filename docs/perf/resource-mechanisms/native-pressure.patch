+//! A native pressure subscription; unsupported targets retain no signal state.
+
+use std::future::Future;
+
+pub struct MemoryPressure {
+    #[cfg(target_os = "macos")]
+    notify: std::sync::Arc<crate::Notify>,
+    #[cfg(target_os = "macos")]
+    seen: u64,
+    #[cfg(target_os = "macos")]
+    _source: sys::resources::MemoryPressure,
+}
+
+impl Default for MemoryPressure {
+    fn default() -> Self {
+        #[cfg(target_os = "macos")]
+        {
+            let notify = std::sync::Arc::new(crate::Notify::new());
+            let seen = notify.count();
+            let callback = std::sync::Arc::clone(&notify);
+            let source = sys::resources::MemoryPressure::new(move || callback.notify());
+            Self {
+                notify,
+                seen,
+                _source: source,
+            }
+        }
+        #[cfg(not(target_os = "macos"))]
+        Self {}
+    }
+}
+
+impl MemoryPressure {
+    pub fn take_request(&mut self) -> bool {
+        #[cfg(target_os = "macos")]
+        {
+            let current = self.notify.count();
+            let requested = current != self.seen;
+            self.seen = current;
+            requested
+        }
+        #[cfg(not(target_os = "macos"))]
+        false
+    }
+
+    pub fn wait<P, O>(&self, pulse: P, other: O) -> impl Future<Output = bool>
+    where
+        P: Future<Output = bool>,
+        O: Future<Output = bool>,
+    {
+        #[cfg(target_os = "macos")]
+        {
+            let notify = &self.notify;
+            let mut seen = self.seen;
+            let pressured = async move {
+                notify.changed(&mut seen).await;
+                false
+            };
+            crate::or(pulse, crate::or(pressured, other))
+        }
+        #[cfg(not(target_os = "macos"))]
+        crate::or(pulse, other)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[cfg(not(target_os = "macos"))]
+    #[test]
+    fn unsupported_pressure_waits_retain_no_state_or_delay_other_events() {
+        let mut pressure = MemoryPressure::default();
+        assert_eq!(std::mem::size_of_val(&pressure), 0);
+        assert!(!pressure.take_request());
+        assert!(crate::block_on(pressure.wait(async { true }, std::future::pending())));
+    }
+
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn a_pressure_wake_stays_pending_until_its_owner_consumes_it() {
+        let mut pressure = MemoryPressure::default();
+        pressure.notify.notify();
+        assert!(!crate::block_on(
+            pressure.wait(std::future::pending(), std::future::pending())
+        ));
+        assert!(pressure.take_request());
+    }
+}

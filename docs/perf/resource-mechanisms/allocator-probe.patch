         unsafe { libc::mallopt(libc::M_ARENA_MAX, 2) };
     }
 }
+
+pub fn pressure_probe_stats() -> [usize; 4] {
+    #[cfg(target_os = "macos")]
+    {
+        #[repr(C)]
+        #[derive(Default)]
+        struct Stats {
+            blocks: u32,
+            used: usize,
+            peak: usize,
+            allocated: usize,
+        }
+        unsafe extern "C" {
+            fn malloc_zone_statistics(zone: *mut std::ffi::c_void, stats: *mut Stats);
+        }
+        let mut stats = Stats::default();
+        // SAFETY: null selects all zones; stats has malloc_statistics_t's layout.
+        unsafe { malloc_zone_statistics(std::ptr::null_mut(), &raw mut stats) };
+        [
+            stats.blocks as usize,
+            stats.used,
+            stats.peak,
+            stats.allocated,
+        ]
+    }
+    #[cfg(not(target_os = "macos"))]
+    [0; 4]
+}
+
+pub fn pressure_probe_relief() -> usize {
+    #[cfg(target_os = "macos")]
+    {
+        unsafe extern "C" {
+            fn malloc_zone_pressure_relief(zone: *mut std::ffi::c_void, goal: usize) -> usize;
+        }
+        // SAFETY: null selects all process-owned zones; zero requests maximal relief.
+        unsafe { malloc_zone_pressure_relief(std::ptr::null_mut(), 0) }
+    }
+    #[cfg(not(target_os = "macos"))]
+    0
+}

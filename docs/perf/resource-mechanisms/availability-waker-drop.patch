+name: o15 availability diagnosis
+on:
+  push:
+    branches: [codex-w5rt-availability]
+    paths: [.github/workflows/o15-availability.yml]
+permissions:
+  contents: read
+jobs:
+  stress:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - label: waker-drop
+            source: 4a06977b6667f0656a417986cfacad5b9ae4a0b2
+            trace: false
+    name: availability (${{ matrix.label }})
+    runs-on: windows-latest
+    timeout-minutes: 180
+    defaults:
+      run:
+        shell: bash
+    env:
+      CARGO_BUILD_JOBS: 4
+      MISE_AUTO_INSTALL: false
+      CARGO_PROFILE_DEV_CODEGEN_BACKEND: llvm
+    steps:
+      - run: git config --global core.autocrlf false
+      - uses: actions/checkout@v7
+        with:
+          path: harness
+      - uses: actions/checkout@v7
+        with:
+          ref: ${{ matrix.source }}
+          path: measured
+      - uses: actions/setup-python@v6
+        with:
+          python-version: '3.13'
+      - run: python -m pip install psutil==7.2.2
+      - uses: jdx/mise-action@v5
+        with:
+          working_directory: measured
+          install_args: rust
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: measured -> target
+          cache-all-crates: true
+      - name: Build the diagnostic source
+        working-directory: measured
+        run: |
+          rustup component add rust-src
+          extra=()
+          if [[ '${{ matrix.trace }}' == true ]]; then extra+=(--features engine/events); fi
+          "$(rustup which cargo)" build-release -p a --features fixtures "${extra[@]}"
+      - name: Exercise idle retirement and cli churn
+        run: |
+          extra=()
+          if [[ '${{ matrix.trace }}' == true ]]; then extra+=(--trace); fi
+          python harness/scripts/perf/availability_stress.py --binary measured/target/release/a.exe --output diagnosis "${extra[@]}"
+      - uses: actions/upload-artifact@v5
+        if: always()
+        with:
+          name: availability-${{ matrix.label }}
+          path: diagnosis
diff --git a/scripts/perf/availability_stress.py b/scripts/perf/availability_stress.py

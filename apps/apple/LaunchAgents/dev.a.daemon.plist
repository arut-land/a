<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>dev.a.daemon</string>
    <key>BundleProgram</key><string>Contents/Helpers/a</string>
    <key>ProgramArguments</key><array><string>a</string><string>__daemon</string><string>--activated</string></array>
    <key>WorkingDirectory</key><string>/</string>
    <key>RunAtLoad</key><true/>
    <key>Umask</key><integer>63</integer>
    <key>ExitTimeOut</key><integer>30</integer>
    <key>ThrottleInterval</key><integer>1</integer>
    <key>Sockets</key><dict><key>daemon</key><dict>
        <key>SecureSocketWithKey</key><string>A_ACTIVATION_SOCKET</string>
        <key>SockPathMode</key><integer>384</integer>
        <key>SockType</key><string>stream</string>
        <key>SockFamily</key><string>Unix</string>
    </dict></dict>
</dict></plist>
